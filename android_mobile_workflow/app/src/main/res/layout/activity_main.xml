<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121218">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NanoPixel Mobile AI Engine"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/resultImageView"
        android:layout_width="256dp"
        android:layout_height="256dp"
        android:layout_gravity="center_horizontal"
        android:background="#1E1E26"
        android:scaleType="fitCenter"
        android:contentDescription="Generated AI Image" />

    <EditText
        android:id="@+id/promptEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="ادخل الوصف العربي أو الإنجليزي..."
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:background="#1E1E26"
        android:padding="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/generateButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="توليد صورة (Generate)"
            android:backgroundTint="#00E5FF"
            android:textColor="#000000" />

        <Button
            android:id="@+id/trainButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="تدريب محلي (Train)"
            android:backgroundTint="#FF4081"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="حالة الجهاز: جاهز للتوليد والتدريب المحلي ONNX"
        android:textColor="#00E5FF"
        android:textSize="14sp" />

</LinearLayout>
